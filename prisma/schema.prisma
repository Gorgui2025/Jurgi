generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  phone         String?   @unique
  phoneVerified Boolean   @default(false)
  name          String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  passwordHash  String?
  avatar        String?
  bio           String?
  location      String?
  region        String?
  commune       String?
  zones         String    @default("[]")
  roles         String    @default("[\"eleveur\"]")
  accountStatus String    @default("active")
  isVerified    Boolean   @default(false)
  verifiedLevel String    @default("none")
  isOnline      Boolean   @default(false)
  lastSeen      DateTime?
  phoneVisible  Boolean   @default(false)
  whatsapp      String?
  resetToken    String?
  resetTokenExpiry DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listings      Listing[]
  requests      Request[]
  requestResponses RequestResponse[]
  messages      Message[]    @relation("sender")
  conversations Conversation[] @relation("conversationsParticipant")
  reviews       Review[]     @relation("reviewedUser")
  reviewsGiven  Review[]     @relation("reviewer")
  reports       Report[]     @relation("reporter")
  farmProfiles  FarmProfile[]
  notifications Notification[]
  auditLogs     AuditLog[]
  subscriptions Subscription[]
  payments      Payment[]
  paymentRequests PaymentRequest[]
}

model Admin {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("support")
  permissions   String   @default("[]")
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FarmProfile {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  farmType    String
  species     String   @default("[]")
  size        String?
  location    String?
  region      String?
  commune     String?
  latitude    Float?
  longitude   Float?
  photos          String   @default("[]")
  videos          String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  listings    Listing[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String?
  description String?
  domain      String
  parent_id   String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      Category?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children    Category[] @relation("CategoryTree")
  listings    Listing[]
  requests    Request[]
}

model Listing {
  id              String   @id @default(cuid())
  userId          String
  categoryId      String
  farmProfileId   String?
  title           String
  description     String
  price           Float?
  priceType       String   @default("fixed")
  currency        String   @default("FCFA")
  priceOnDemand   Boolean  @default(false)
  photos          String   @default("[]")
  videos          String   @default("[]")
  location        String?
  region          String?
  commune         String?
  latitude        Float?
  longitude       Float?
  status          String   @default("active")
  availability    String   @default("available")
  contactMode     String   @default("phone_whatsapp")
  expiresAt       DateTime?
  views           Int      @default(0)
  featured        Boolean  @default(false)
  species         String?
  breed           String?
  age             String?
  weight          String?
  sex             String?
  quantity        Int?
  healthInfo      String?
  deliveryOptions String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User        @relation(fields: [userId], references: [id])
  category        Category    @relation(fields: [categoryId], references: [id])
  farmProfile     FarmProfile? @relation(fields: [farmProfileId], references: [id])
  requestResponses RequestResponse[]
}

model Request {
  id              String   @id @default(cuid())
  userId          String
  categoryId      String?
  title           String
  description     String
  quantity         String?
  budget          String?
  location        String?
  region          String?
  commune         String?
  deadline        String?
  urgency         String   @default("normal")
  photos          String   @default("[]")
  status          String   @default("active")
  visibility      String   @default("public")
  contactMode     String   @default("phone_whatsapp")
  views           Int      @default(0)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id])
  category        Category?         @relation(fields: [categoryId], references: [id])
  responses       RequestResponse[]
}

model RequestResponse {
  id          String   @id @default(cuid())
  requestId   String
  userId      String
  listingId   String?
  message     String
  price       Float?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  request     Request  @relation(fields: [requestId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  listing     Listing? @relation(fields: [listingId], references: [id])
}

model Conversation {
  id          String   @id @default(cuid())
  name        String?
  isGroup     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants User[]        @relation("conversationsParticipant")
  messages     Message[]
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  senderId        String
  content         String
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id])
  sender          User         @relation("sender", fields: [senderId], references: [id])
}

model Review {
  id          String   @id @default(cuid())
  reviewerId  String
  userId      String
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  reviewer    User @relation("reviewer", fields: [reviewerId], references: [id])
  user        User @relation("reviewedUser", fields: [userId], references: [id])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  targetType  String
  targetId    String
  reason      String
  description String?
  status      String   @default("pending")
  resolution  String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  reporter    User @relation("reporter", fields: [reporterId], references: [id])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  message     String
  data        String   @default("{}")
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  adminId     String?
  action      String
  entityType  String
  entityId    String?
  details     String   @default("{}")
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}

model AdminActionLog {
  id          String   @id @default(cuid())
  adminId     String
  adminEmail  String
  adminRole   String
  action      String
  entityType  String
  entityId    String?
  oldValue    String?
  newValue    String?
  reason      String?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model AdminLoginLog {
  id          String   @id @default(cuid())
  adminId     String
  email       String
  success     Boolean
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

model Plan {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  name                    String
  description             String?
  price                   Int      @default(0)
  currency                String   @default("XOF")
  durationDays            Int      @default(0)
  maxActiveListings       Int      @default(3)
  maxPhotosPerListing     Int      @default(6)
  maxVideosPerListing     Int      @default(1)
  maxVideoSizeMb          Int      @default(50)
  autoRenew               Boolean  @default(false)
  isTrialEligible         Boolean  @default(false)
  isVisible               Boolean  @default(true)
  isActive                Boolean  @default(true)
  sortOrder               Int      @default(0)
  commercialMessage       String?
  createdByAdminId        String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  versions                PlanVersion[]
  subscriptions           Subscription[]
  promotions              Promotion[]
  payments                Payment[]
  paymentRequests         PaymentRequest[]
}

model PlanVersion {
  id              String   @id @default(cuid())
  planId          String
  version         Int
  snapshot        String
  oldSnapshot     String?
  changeReason    String?
  changedByAdminId String?
  createdAt       DateTime @default(now())

  plan            Plan     @relation(fields: [planId], references: [id])
}

model Subscription {
  id                    String   @id @default(cuid())
  userId                String
  planId                String
  status                String   @default("active")
  startDate             DateTime @default(now())
  endDate               DateTime?
  autoRenew             Boolean  @default(false)
  trialUsed             Boolean  @default(false)
  suspendedByQuota      Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id])
  plan                  Plan     @relation(fields: [planId], references: [id])
  payments              Payment[]
}

model Payment {
  id                    String   @id @default(cuid())
  userId                String
  subscriptionId        String?
  planId                String
  amount                Int
  currency              String   @default("XOF")
  paymentMethod         String?
  providerRef           String?
  providerStatus        String?
  promotionId           String?
  promoDiscount         Int?
  finalAmount           Int
  status                String   @default("pending")
  metadata              String   @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User       @relation(fields: [userId], references: [id])
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id])
  plan                  Plan       @relation(fields: [planId], references: [id])
  promotion             Promotion? @relation(fields: [promotionId], references: [id])
}

model Promotion {
  id                    String   @id @default(cuid())
  name                  String
  code                  String?
  planId                String
  discountType          String   @default("fixed")
  discountValue         Int
  promotionalPrice      Int
  startDate             DateTime
  endDate               DateTime
  maxTotalUses          Int?
  maxUsesPerUser        Int      @default(1)
  newUsersOnly          Boolean  @default(false)
  existingUsersOnly     Boolean  @default(false)
  compatibleWithTrial   Boolean  @default(false)
  applyToRenewal        Boolean  @default(false)
  status                String   @default("active")
  displayMessage        String?
  createdByAdminId      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  plan                  Plan     @relation(fields: [planId], references: [id])
  usages                PromotionUsage[]
  payments              Payment[]
}

model PromotionUsage {
  id          String   @id @default(cuid())
  promotionId String
  userId      String
  paymentId   String?
  usedAt      DateTime @default(now())

  promotion   Promotion @relation(fields: [promotionId], references: [id])

  @@unique([promotionId, userId])
}

model SiteConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt
}

model Training {
  id          String   @id @default(cuid())
  title       String
  provider    String
  type        String
  level       String
  duration    String
  format      String
  price       String
  location    String
  date        String
  maxParticipants Int  @default(50)
  description String
  tags        String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments TrainingEnrollment[]
}

model TrainingEnrollment {
  id          String   @id @default(cuid())
  trainingId  String
  userId      String?
  name        String
  phone       String
  createdAt   DateTime @default(now())

  training    Training @relation(fields: [trainingId], references: [id])

  @@unique([trainingId, phone])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model PaymentRequest {
  id                String   @id @default(cuid())
  userId            String
  planId            String
  amount            Int
  currency          String   @default("XOF")
  transactionRef    String?
  userNote          String?
  status            String   @default("pending")
  activationCode    String?
  validatedByAdminId String?
  validatedAt       DateTime?
  rejectionReason   String?
  escalationLevel   Int      @default(0)
  lastEscalationAt  DateTime?
  autoValidated     Boolean  @default(false)
  metadata          String   @default("{}")
  expiresAt         DateTime @default(dbgenerated("(now() + interval '24 hours')"))
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id])
  plan              Plan     @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([activationCode])
}
